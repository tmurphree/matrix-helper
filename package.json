{
    "author": "Tom Murphree",
    "dependencies": {
        "nuxt": "4.1.3",
        "vue": "3.5.44",
        "vue-router": "5.4.0"
    },
    "description": "Helper utilities for Matrix",
    "devDependencies": {
        "@commitlint/cli": "21.2.4",
        "@commitlint/config-conventional": "21.2.4",
        "@nuxt/test-utils": "4.3.4",
        "@types/node": "24.12.0",
        "@vue/test-utils": "2.5.1",
        "eslint": "10.4.0",
        "eslint-config-prettier": "10.1.8",
        "happy-dom": "21.0.4",
        "husky": "9.1.7",
        "prettier": "3.8.3",
        "prettier-plugin-organize-imports": "4.3.0",
        "typescript": "5.9.3",
        "vitest": "5.1.0",
        "vue-tsc": "3.3.14"
    },
    "engines": {
        "node": "26.13.0",
        "npm": "12.2.x"
    },
    "license": "All rights reserved",
    "name": "matrix-helper",
    "overrides": {
        "js-yaml": "4.3.2"
    },
    "packageManager": "npm@12.2.x",
    "private": true,
    "scripts": {
        "build": "nuxt build",
        "check": "npm run lint && npm run format",
        "clean": "rm -rf ./node_modules/",
        "dev": "nuxt dev",
        "format": "prettier --check .",
        "format:write": "prettier --write .",
        "generate": "nuxt generate",
        "lint": "eslint .",
        "postinstall": "nuxt prepare",
        "prepare": "husky",
        "preview": "nuxt preview",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "type": "module",
    "version": "1.0.0"
}
